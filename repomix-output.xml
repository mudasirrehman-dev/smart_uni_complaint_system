<file path="templates/admin_dashboard.html">
{% extends "base.html" %} 
{% block title %} Admin Dashboard | Smart University
Complaint System 
{% endblock %} 

{% block extra_css %}
<!-- This is Text Editor CSS - Do Not remove it: Solution / Feedback -->
 <style>
  .rich-text-editor {
    min-height: 220px;
    max-height: 350px;

    padding: 18px 20px;

    background-color: #ffffff;

    border: none;
    outline: none;

    font-size: 16px;
    line-height: 1.6;

    cursor: text;

    overflow-y: auto;

    white-space: normal;
  }

  /* Placeholder */

  .rich-text-editor:empty::before {
    content: attr(data-placeholder);

    color: #6c757d;

    pointer-events: none;
  }

  /* Editor focus */

  .rich-text-editor:focus {
    outline: none;
    box-shadow: none;
  }

  /* Selected text */

  .rich-text-editor ::selection {
    background-color: #b6d7ff;
  }

  /* Text inside editor */

  .rich-text-editor p {
    margin-bottom: 8px;
  }

  /* Highlighted text */

  .rich-text-editor span {
    line-height: inherit;
  }
</style>
{% endblock %}

{% block content %}

<div class="container py-4">
  <!-- ============================= -->
  <!-- PAGE HEADER -->
  <!-- ============================= -->

  <div
    class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4"
  >
    <div>
      <h2 class="fw-bold mb-1">Admin Dashboard</h2>

      <p class="text-muted mb-0">
        Welcome back, {{ username }}. Manage and monitor student complaints.
      </p>
    </div>

    <div class="mt-3 mt-md-0">
      <span class="badge text-bg-primary px-3 py-2">
        <i class="bi bi-shield-check me-1"></i>
        Administrator
      </span>
    </div>
  </div>

  <!-- ============================= -->
  <!-- STATISTICS CARDS -->
  <!-- ============================= -->

  <div class="row g-4 mb-4">
    <!-- Total Complaints -->

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Total Complaints</p>

              <h2 class="fw-bold mb-0">{{ complaints|length }}</h2>
            </div>

            <div class="stat-icon bg-primary-subtle text-primary">
              <i class="bi bi-file-earmark-text"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Emergency -->

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Emergency</p>

              <h2 class="fw-bold mb-0">
                {{ complaints | selectattr("urgency_level", "equalto",
                "Emergency") | selectattr("status", "equalto", "Pending") | list
                | length }}
              </h2>
            </div>

            <div class="stat-icon bg-danger-subtle text-danger">
              <i class="bi bi-exclamation-triangle"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pending -->

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Pending</p>

              <h2 class="fw-bold mb-0">
                {{ complaints | selectattr("status", "equalto", "Pending") |
                list | length }}
              </h2>
            </div>

            <div class="stat-icon bg-warning-subtle text-warning">
              <i class="bi bi-clock-history"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Solved -->

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Solved</p>

              <h2 class="fw-bold mb-0">
                {{ complaints | selectattr("status", "equalto", "Solved") | list
                | length }}
              </h2>
            </div>

            <div class="stat-icon bg-success-subtle text-success">
              <i class="bi bi-check-circle"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================= -->
  <!-- COMPLAINT QUEUE -->
  <!-- ============================= -->

  <div class="card border-0 shadow-sm mb-4">
    <!-- Header -->

    <div class="card-header bg-white border-bottom py-3">
      <div
        class="d-flex flex-column flex-md-row justify-content-between align-items-md-center"
      >
        <div>
          <h5 class="fw-bold mb-1">
            <i class="bi bi-inbox me-2"></i>
            Complaint Queue
          </h5>

          <p class="text-muted small mb-0">
            Manage all student complaints and take appropriate action.
          </p>
        </div>

        <span class="badge text-bg-secondary mt-2 mt-md-0">
          {{ complaints|length }} Complaints
        </span>
      </div>
    </div>

    <!-- ============================= -->
    <!-- COMPLAINT TABLE -->
    <!-- ============================= -->

    <div class="card-body p-0">
      {% if complaints %}

      <form method="POST">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Select</th>
                <th>ID</th>
                <th>Student</th>
                <th>Category</th>
                <th>Directed Against</th>
                <th>Description</th>
                <th>Urgency</th>
                <th>Status</th>
                <th>Date</th>
                <th class="text-end pe-4">Actions</th>
              </tr>
            </thead>

            <tbody>

    {% for complaint in complaints %}

    <!-- Emergency Pending Row -->

    <tr
        {% if complaint.urgency_level == "Emergency"
        and complaint.status == "Pending" %}
        class="table-danger"
        {% endif %}
    >

        <!-- Select -->

        <td class="ps-4">

            {% if complaint.status == "Pending" %}

            <input
                class="form-check-input"
                type="checkbox"
                name="complaint_ids"
                value="{{ complaint.id }}"
            >

            {% endif %}

        </td>


        <!-- Complaint ID -->

        <td>

            <strong>
                #{{ complaint.id }}
            </strong>

        </td>


        <!-- Student -->

        <td>

            Student {{ complaint.student_id }}

        </td>


        <!-- Category -->

        <td>

            <span class="fw-semibold">
                {{ complaint.category }}
            </span>

        </td>


        <!-- Directed Against -->

        <td>

            <span class="badge text-bg-dark">
                {{ complaint.directed_against }}
            </span>

        </td>


        <!-- Description -->

        <td style="max-width: 250px;">

            {% if complaint.description|length > 60 %}

            <details class="description-details">

                <summary>

                    <span class="short-description">
                        {{ complaint.description[:60] }}...
                    </span>

                    <span class="full-description">
                        {{ complaint.description }}
                    </span>

                </summary>

            </details>

            {% else %}

            <span>
                {{ complaint.description }}
            </span>

            {% endif %}

        </td>


        <!-- Urgency -->

        <td>

            {% if complaint.urgency_level == "Emergency" %}

            <span class="badge text-bg-danger">

                <i class="bi bi-exclamation-triangle-fill"></i>

                Emergency

            </span>

            {% else %}

            <span class="badge text-bg-secondary">

                {{ complaint.urgency_level }}

            </span>

            {% endif %}

        </td>


        <!-- Status -->

        <td>

            {% if complaint.status == "Pending" %}

            <span class="badge text-bg-warning">

                <i class="bi bi-clock"></i>

                Pending

            </span>

            {% elif complaint.status == "Forwarded" %}

            <span class="badge text-bg-info">

                <i class="bi bi-send"></i>

                Forwarded

            </span>

            {% elif complaint.status == "Solved" %}

            <span class="badge text-bg-success">

                <i class="bi bi-check-circle"></i>

                Solved

            </span>

            {% elif complaint.status == "Rejected" %}

            <span class="badge text-bg-danger">

                <i class="bi bi-x-circle"></i>

                Rejected

            </span>

            {% else %}

            <span class="badge text-bg-secondary">

                {{ complaint.status }}

            </span>

            {% endif %}

        </td>


        <!-- Date -->

        <td class="text-muted small">

            {{ complaint.date_submitted.strftime('%d %b %Y') }}

            <br>

            {{ complaint.date_submitted.strftime('%I:%M %p') }}

        </td>


        <!-- Actions -->

        <td class="text-end pe-4">

            {% if complaint.status == "Pending" %}

            <div class="btn-group">


                <!-- Solve -->

                <button
                    type="button"
                    class="btn btn-sm btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#solveModal{{ complaint.id }}"
                >

                    <i class="bi bi-check-lg"></i>

                    Solve

                </button>


                <!-- Forward -->

                <button
                    type="submit"
                    formaction="{{ url_for('forward_to_hod', complaint_id=complaint.id) }}"
                    class="btn btn-sm btn-outline-primary"
                >

                    <i class="bi bi-send"></i>

                    Forward

                </button>


                <!-- Reject -->

                <button
                    type="button"
                    class="btn btn-sm btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#rejectModal{{ complaint.id }}"
                >

                    <i class="bi bi-x-lg"></i>

                    Reject

                </button>


            </div>

            {% else %}

            <span class="text-muted small">

                No action required

            </span>

            {% endif %}

        </td>

    </tr>


    {% endfor %}

</tbody>
          </table>
        </div>

        <!-- ============================= -->
        <!-- GROUP SELECTED COMPLAINTS -->
        <!-- ============================= -->

        <div class="border-top p-3 bg-light">
          <div
            class="d-flex flex-column flex-md-row justify-content-between align-items-md-center"
          >
            <small class="text-muted mb-2 mb-md-0">
              Select at least 2 pending complaints with the same
              <strong>Directed Against</strong>
              value to create a group.
            </small>

            <button
              type="submit"
              formaction="{{ url_for('group_complaints') }}"
              class="btn btn-primary"
            >
              <i class="bi bi-collection me-1"></i>
              Group Selected Complaints
            </button>
          </div>
        </div>
      </form>

      <!-- ========================================================= -->
      <!-- SOLVE / REJECT MODALS -->
      <!-- ========================================================= -->

      {% for complaint in complaints %} {% if complaint.status == "Pending" %}

      <!-- ===================================================== -->
      <!-- SOLVE COMPLAINT MODAL -->
      <!-- ===================================================== -->

      <div
        class="modal fade"
        id="solveModal{{ complaint.id }}"
        tabindex="-1"
        aria-labelledby="solveModalLabel{{ complaint.id }}"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
          <div class="modal-content">
            <!-- ============================= -->
            <!-- MODAL HEADER -->
            <!-- ============================= -->

            <div class="modal-header">
              <h4
                class="modal-title fw-bold"
                id="solveModalLabel{{ complaint.id }}"
              >
                <i class="bi bi-check-circle text-success me-2"></i>
                Solve Complaint
              </h4>

              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>

            <!-- ============================= -->
            <!-- MODAL BODY -->
            <!-- ============================= -->

            <div class="modal-body bg-light">
              <div class="container-fluid">
                <div class="card border-0 shadow-sm">
