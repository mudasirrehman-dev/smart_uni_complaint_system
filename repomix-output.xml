                                    <small class="text-muted">
                                        Only select this option for urgent issues requiring immediate attention.
                                    </small>

                                    <!-- Emergency Counter -->
                                    <div class="mt-2">

                                        <small class="text-muted fw-semibold">
                                            Emergency Complaints:
                                            {{ emergency_count }}/2
                                        </small>

                                    </div>

                                {% endif %}

                            </div>

                        </div>


                        <!-- ================================= -->
                        <!-- BUTTONS -->
                        <!-- ================================= -->

                        <div class="d-flex gap-2">

                            <button
                                type="submit"
                                class="btn btn-primary px-4"
                                id="submitBtn"
                            >

                                <i class="bi bi-send me-1"></i>

                                Submit Complaint

                            </button>


                            <a
                                href="{{ url_for('student_dashboard') }}"
                                class="btn btn-outline-secondary"
                            >
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ========================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================= -->

<script>

const directedAgainst = document.getElementById(
    "directed_against"
);

const customTargetContainer = document.getElementById(
    "customTargetContainer"
);

const customTarget = document.getElementById(
    "custom_target"
);


/*
    Show Custom Target field only when
    "Other" is selected.
*/

directedAgainst.addEventListener(
    "change",
    function () {

        if (this.value === "Other") {

            // Show custom target field
            customTargetContainer.style.display = "block";

            // Make field required
            customTarget.required = true;

        } else {

            // Hide custom target field
            customTargetContainer.style.display = "none";

            // Remove required validation
            customTarget.required = false;

            // Clear previous value
            customTarget.value = "";

        }

    }
);


/*
    Prevent double submission.
*/

document.getElementById("complaintForm").addEventListener(
    "submit",
    function () {

        const submitBtn = document.getElementById(
            "submitBtn"
        );

        // Disable button immediately
        submitBtn.disabled = true;

        // Show loading state
        submitBtn.innerHTML = `
            <span
                class="spinner-border spinner-border-sm me-2"
                role="status"
            ></span>
            Submitting...
        `;

    }
);

</script>

{% endblock %}
