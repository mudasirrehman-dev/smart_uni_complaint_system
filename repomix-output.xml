<script>

    /* =========================================================
       DESCRIPTION TOGGLE
       ========================================================= */

    function toggleDescription(element) {

        const fullTextElement =
            element.nextElementSibling;

        const fullText =
            fullTextElement.textContent.trim();

        const shortText =
            fullText.substring(0, 60) + "...";


        if (element.dataset.expanded === "true") {

            element.textContent = shortText;

            element.dataset.expanded = "false";

        } else {

            element.textContent = fullText;

            element.dataset.expanded = "true";

        }
    }


    /* =========================================================
       RICH TEXT EDITOR
       ========================================================= */


    /*
       Har editor ki selection separately save hogi.

       Example:

       solveEditor1
       rejectEditor1
       solveEditor2
       rejectEditor2

       Is se ek complaint ke editor ki selection
       doosre editor ke saath mix nahi hogi.
    */

    const editorSelections = {};


    /* =========================================================
       GET EDITOR
       ========================================================= */

    function getEditor(editorId) {

        /*
           Solve editor
           Example: solveEditor5
        */

        let editor =
            document.getElementById(
                "solveEditor" + editorId
            );

        if (editor) {
            return editor;
        }


        /*
           Reject editor
           Example: solveEditorreject5
        */

        editor =
            document.getElementById(
                "solveEditorreject" + editorId
            );

        return editor;
    }


    /* =========================================================
       SAVE SELECTION
       ========================================================= */

    function saveSelection(editorId) {

        const editor =
            getEditor(editorId);

        if (!editor) {
            return;
        }


        const selection =
            window.getSelection();

        if (
            !selection ||
            selection.rangeCount === 0
        ) {
            return;
        }


        const range =
            selection.getRangeAt(0);


        /*
           Check karein ke selected text
           isi editor ke andar hai.
        */

        let node =
            range.commonAncestorContainer;


        if (
            node.nodeType === Node.TEXT_NODE
        ) {
            node = node.parentNode;
        }


        if (
            node &&
            editor.contains(node)
        ) {

            editorSelections[editorId] =
                range.cloneRange();

        }
    }


    /* =========================================================
       RESTORE SELECTION
       ========================================================= */

    function restoreSelection(editorId) {

        const savedRange =
            editorSelections[editorId];

        if (!savedRange) {
            return;
        }


        const selection =
            window.getSelection();


        selection.removeAllRanges();


        selection.addRange(
            savedRange
        );
    }


    /* =========================================================
       FORMAT TEXT
       ========================================================= */

    function formatEditor(
        command,
        editorId
    ) {

        const editor =
            getEditor(editorId);

        if (!editor) {
            return;
        }


        /*
           Editor ko focus karein.
        */

        editor.focus();


        /*
           User ka previous selected text
           restore karein.
        */

        restoreSelection(editorId);


        /*
           Bold / Italic / Underline
        */

        document.execCommand(
            command,
            false,
            null
        );


        /*
           Formatting ke baad selection save karein.
        */

        saveSelection(editorId);


        /*
           Cursor editor mein rakhein.
        */

        editor.focus();
    }


    /* =========================================================
       FONT SIZE
       ========================================================= */

    function changeFontSize(
        size,
        editorId
    ) {

        if (!size) {
            return;
        }


        const editor =
            getEditor(editorId);

        if (!editor) {
            return;
        }


        editor.focus();


        /*
           Selected text restore karein.
        */

        restoreSelection(editorId);


        /*
           Font size apply karein.

           1 = Very Small
           2 = Small
           3 = Normal
           4 = Large
           5 = Very Large
        */

        document.execCommand(
            "fontSize",
            false,
            size
        );


        /*
           New selection save karein.
        */

        saveSelection(editorId);


        editor.focus();
    }


    /* =========================================================
       HIGHLIGHT TEXT
       ========================================================= */

    function highlightEditor(
        editorId
    ) {

        const editor =
            getEditor(editorId);

        if (!editor) {
            return;
        }


        editor.focus();


        /*
           Selected text restore karein.
        */

        restoreSelection(editorId);


        /*
           Highlight apply karein.
        */

        document.execCommand(
            "backColor",
            false,
            "#fff3cd"
        );


        /*
           Selection save karein.
        */

        saveSelection(editorId);


        editor.focus();
    }


    /* =========================================================
       SELECTION CHANGE
       ========================================================= */

    document.addEventListener(
        "selectionchange",
        function () {

            /*
               Solve editors check karein.
            */

            document
                .querySelectorAll(
                    ".rich-text-editor"
                )
                .forEach(function(editor) {

                    const selection =
                        window.getSelection();

                    if (
                        !selection ||
                        selection.rangeCount === 0
                    ) {
                        return;
                    }


                    const range =
                        selection.getRangeAt(0);

                    let node =
                        range.commonAncestorContainer;


                    if (
                        node.nodeType ===
                        Node.TEXT_NODE
                    ) {
                        node = node.parentNode;
                    }


                    /*
                       Agar selection is editor
                       ke andar hai to save karein.
                    */

                    if (
                        node &&
                        editor.contains(node)
                    ) {

                        let editorId = "";


                        /*
                           Solve editor ID
                           Example:

                           solveEditor5

                           -> 5
                        */

                        if (
                            editor.id.startsWith(
                                "solveEditorreject"
                            )
                        ) {

                            editorId =
                                editor.id.replace(
                                    "solveEditorreject",
                                    ""
                                );

                        } else {

                            editorId =
                                editor.id.replace(
                                    "solveEditor",
                                    ""
                                );
                        }


                        if (editorId) {

                            editorSelections[
                                editorId
                            ] =
                                range.cloneRange();

                        }

                    }

                });

        }
    );


    /* =========================================================
       PREPARE SOLUTION BEFORE SUBMIT
       ========================================================= */

    function prepareEditor(
        complaintId
    ) {

        const editor =
            document.getElementById(
                "solveEditor" + complaintId
            );


        const hiddenField =
            document.getElementById(
                "solveHidden" + complaintId
            );


        if (
            editor &&
            hiddenField
        ) {

            hiddenField.value =
                editor.innerHTML;

        }
    }


    /* =========================================================
       PREPARE REJECTION BEFORE SUBMIT
       ========================================================= */

    function prepareRejectEditor(
        complaintId
    ) {

        const editor =
            document.getElementById(
                "solveEditorreject" +
                complaintId
            );


        const hiddenField =
            document.getElementById(
                "rejectHidden" +
                complaintId
            );


        if (
            editor &&
            hiddenField
        ) {

            hiddenField.value =
                editor.innerHTML;

        }
    }


    /* =========================================================
       EDITOR PLACEHOLDER
       ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            document
                .querySelectorAll(
                    ".rich-text-editor"
                )
                .forEach(function(editor) {

                    /*
                       Ensure editor is editable.
                    */

                    editor.setAttribute(
                        "contenteditable",
                        "true"
                    );


                    /*
                       Spell checking enable.
                    */

                    editor.setAttribute(
                        "spellcheck",
                        "true"
                    );

                });

        }
    );

</script>

