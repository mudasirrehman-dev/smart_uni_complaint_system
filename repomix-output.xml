<div class="card-body">
  {% for group_id, complaints_in_group in groups.items() %}

  <!-- GROUP CARD -->
  <div class="card border shadow-sm mb-3">

    <!-- GROUP HEADER -->
    <div
      class="card-header p-3"
      style="background-color: {{ ['#D6E8FF', '#F8D7E8', '#FFE0B2', '#E2D5F8', '#BFEFF2', '#FFF3B0', '#FFD6D6', '#D9E7D0', '#D7D9FF'][(group_id|int) % 9] }} !important;"
    >
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

        <div>
          <h6 class="fw-bold mb-1">Group #{{ loop.index }}</h6>
          <small class="text-muted">{{ complaints_in_group|length }} complaints</small>
