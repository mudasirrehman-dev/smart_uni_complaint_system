                <!-- =================================================
                     DATE
                     ================================================= -->

                <div class="table-responsive mb-4">

                  <table class="table table-bordered align-middle mb-0">

                    <tbody>

                      <tr>

                        <th
                          class="bg-light"
                          style="width: 180px;"
                        >

                          <i class="bi bi-calendar3 me-2"></i>

                          Date

                        </th>

                        <td>

                          {{ complaint.date_submitted.strftime('%d %b %Y at %I:%M %p') }}

                        </td>

                      </tr>

                    </tbody>

                  </table>

                </div>


                <!-- =================================================
                     BASIC COMPLAINT INFORMATION
                     ================================================= -->

                <div class="table-responsive mb-4">

                  <table
                    class="table table-bordered align-middle mb-0"
                    style="min-width: 950px;"
                  >

                    <thead class="table-light">

                      <tr>

                        <th>ID</th>

                        <th>Student</th>

                        <th>Category</th>

                        <th>Directed Against</th>

                        <th>Urgency</th>

                        <th>Status</th>

                      </tr>

                    </thead>


                    <tbody>

                      <tr>


                        <!-- ID -->

                        <td class="fw-semibold">

                          #{{ complaint.id }}

                        </td>


                        <!-- STUDENT -->

                        <td>

                          Student {{ complaint.student_id }}

                        </td>


                        <!-- CATEGORY -->

                        <td>

                          {{ complaint.category }}

                        </td>


                        <!-- DIRECTED AGAINST -->

                        <td>

                          <span class="badge text-bg-dark">

                            {{ complaint.directed_against }}

                          </span>


                          {% if complaint.custom_target %}

                          <div class="text-muted small mt-1">

                            {{ complaint.custom_target }}

                          </div>

                          {% endif %}

                        </td>


                        <!-- URGENCY -->

                        <td>

                          {% if complaint.urgency_level == "Emergency" %}

                            <span class="badge bg-danger">

                              <i class="bi bi-exclamation-triangle me-1"></i>

                              Emergency

                            </span>

                          {% else %}

                            <span class="badge bg-secondary">

                              {{ complaint.urgency_level }}

                            </span>

                          {% endif %}

                        </td>


                        <!-- STATUS -->

                        <td>

                          {% if complaint.status == "Pending" %}

                            <span class="badge bg-warning text-dark">

                              Pending

                            </span>

                          {% elif complaint.status == "In Progress" %}

                            <span class="badge bg-info text-dark">

                              In Progress

                            </span>

                          {% elif complaint.status == "Forwarded" %}

                            <span class="badge bg-primary">

                              Forwarded

                            </span>

                          {% elif complaint.status == "Solved" %}

                            <span class="badge bg-success">

                              Solved

                            </span>

                          {% elif complaint.status == "Rejected" %}

                            <span class="badge bg-danger">

                              Rejected

                            </span>

                          {% else %}

                            <span class="badge bg-secondary">

                              {{ complaint.status }}

                            </span>

                          {% endif %}

                        </td>


                      </tr>

                    </tbody>

                  </table>

                </div>


                <!-- =================================================
                     COMPLAINT DESCRIPTION
                     ================================================= -->

                <div class="mt-4">

                  <h6 class="fw-bold mb-2">

                    <i class="bi bi-chat-left-text me-2"></i>

                    Complaint Description

                  </h6>


                  <div class="card bg-light border">

                    <div class="card-body">

                      {{ complaint.description }}

                    </div>

                  </div>

                </div>


                <!-- =================================================
                     SEPARATOR
                     ================================================= -->

                <hr class="my-4 border-3 opacity-50" />


                <!-- =================================================
                     REJECTION REASON / FEEDBACK
                     ================================================= -->

                <form
                  method="POST"
                  action="{{ url_for('hod_reject_complaint', complaint_id=complaint.id) }}"
                  onsubmit="return prepareRejectEditor('{{ complaint.id }}')"
                >


                  <!-- =================================================
                       REJECTION REASON HEADING
                       ================================================= -->

                  <h5 class="fw-bold mb-3">

                    <i class="bi bi-pencil-square me-2"></i>

                    Rejection Reason / Feedback

                  </h5>


                  <!-- =================================================
                       RICH TEXT EDITOR
                       ================================================= -->

                  <div class="card border">

                    <div
                      id="rejectEditor{{ complaint.id }}"
                      class="rich-text-editor"
                      contenteditable="true"
                      spellcheck="true"
                      data-placeholder="Enter reason for rejecting this complaint..."
                      oninput="
                        document.getElementById(
                          'rejectHidden{{ complaint.id }}'
                        ).value = this.innerHTML;
                      "
                      onmouseup="saveSelection('{{ complaint.id }}')"
                      onkeyup="saveSelection('{{ complaint.id }}')"
                    ></div>

                  </div>


                  <!-- =================================================
                       HIDDEN FIELD
                       ================================================= -->

                  <textarea
                    id="rejectHidden{{ complaint.id }}"
                    name="reason"
                    hidden
                  ></textarea>


                  <!-- =================================================
                       ACTION BUTTONS
                       ================================================= -->

                  <div class="d-flex justify-content-end gap-2 mt-4">


                    <!-- CANCEL -->

                    <button
                      type="button"
                      class="btn btn-secondary"
                      data-bs-dismiss="modal"
                    >

                      <i class="bi bi-x-lg me-1"></i>

                      Cancel

                    </button>


                    <!-- REJECT -->

                    <button
                      type="submit"
                      class="btn btn-danger"
                    >

                      <i class="bi bi-x-lg me-1"></i>

                      Reject Complaint

                    </button>


                  </div>


                </form>


              </div>

            </div>

          </div>

        </div>


      </div>

    </div>

  </div>

  {% endif %}

{% endfor %}

{% endblock %}
</file>

<file path="create_users.py">
from app import app
from extensions import db
from models import User
from werkzeug.security import generate_password_hash


with app.app_context():

    # Check if student7 already exists
    existing_user = User.query.filter_by(
        username="student7"
    ).first()

    if existing_user:
        print("student7 already exists")

    else:

        student7 = User(
            username="student7",
            password_hash=generate_password_hash("student123"),
            role="student"
        )

        db.session.add(student7)
        db.session.commit()

        print("student7 created successfully!")
