            class="m-0"
          >
            <button type="submit" class="btn btn-outline-danger">
              <i class="bi bi-arrow-counterclockwise me-1"></i>
              Undo Group
            </button>
          </form>

          <form
            method="POST"
            action="{{ url_for('forward_group_to_hod', group_id=group_id) }}"
            onsubmit="return confirm('Are you sure you want to forward this group to HOD?');"
            class="m-0"
          >
            <button type="submit" class="btn btn-outline-primary">
              <i class="bi bi-send me-1"></i>
              Forward to HOD
            </button>
          </form>

          <button
            type="button"
            class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#solveGroupModal{{ group_id }}"
          >
            <i class="bi bi-check-circle me-1"></i>
            Solve Group
          </button>

        </div>

        {% else %}

          {% if complaints_in_group[0].status == "Forwarded" %}
            <span class="badge text-bg-info px-3 py-2">Forwarded</span>
          {% elif complaints_in_group[0].status == "Solved" %}
            <span class="badge text-bg-success px-3 py-2">Solved</span>
          {% elif complaints_in_group[0].status == "Rejected" %}
            <span class="badge text-bg-danger px-3 py-2">Rejected</span>
          {% endif %}

        {% endif %}

      </div>
    </div>

