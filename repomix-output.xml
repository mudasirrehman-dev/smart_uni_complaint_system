   ========================================================= */

  /*
   Har editor ki selection separately save hogi.

   Example:

   solveEditor1
   solveEditorreject1

   solveEditor2
   solveEditorreject2
*/

  const editorSelections = {};

  /* =========================================================
   GET EDITOR
   ========================================================= */

  function getEditor(editorId) {
    /* -----------------------------------------
       Solve Editor
       ----------------------------------------- */

    let editor = document.getElementById("solveEditor" + editorId);

    if (editor) {
      return editor;
    }

    /* -----------------------------------------
       Reject Editor
       ----------------------------------------- */

    editor = document.getElementById("solveEditorreject" + editorId);

    return editor;
  }

  /* =========================================================
   SAVE SELECTION
   ========================================================= */

  function saveSelection(editorId) {
    const editor = getEditor(editorId);

    if (!editor) {
      return;
    }

    const selection = window.getSelection();

    if (!selection || selection.rangeCount === 0) {
      return;
    }

    const range = selection.getRangeAt(0);

    let node = range.commonAncestorContainer;

    if (node.nodeType === Node.TEXT_NODE) {
      node = node.parentNode;
    }

    /*
       Check karein ke selection
       isi editor ke andar hai.
    */

    if (node && editor.contains(node)) {
      editorSelections[editorId] = range.cloneRange();
    }
  }

  /* =========================================================
   RESTORE SELECTION
   ========================================================= */

  function restoreSelection(editorId) {
    const savedRange = editorSelections[editorId];

    if (!savedRange) {
      return;
    }

    const selection = window.getSelection();

    selection.removeAllRanges();

    selection.addRange(savedRange);
  }

  /* =========================================================
   FORMAT TEXT
   ========================================================= */

  function formatEditor(command, editorId) {
    const editor = getEditor(editorId);

    if (!editor) {
      return;
    }

    /* Editor focus */

    editor.focus();

    /* Previous selection restore */

    restoreSelection(editorId);

    /* Apply formatting */

    document.execCommand(command, false, null);

    /* Save new selection */

    saveSelection(editorId);

    /* Keep focus */

    editor.focus();
  }

  /* =========================================================
   FONT SIZE
   ========================================================= */

  function changeFontSize(size, editorId) {
    if (!size) {
      return;
    }

    const editor = getEditor(editorId);

    if (!editor) {
      return;
    }

    editor.focus();

    restoreSelection(editorId);

    /*
       Font sizes:

       1 = Very Small
       2 = Small
       3 = Normal
       4 = Large
       5 = Very Large
    */

    document.execCommand("fontSize", false, size);

    saveSelection(editorId);

    editor.focus();
  }

  /* =========================================================
   HIGHLIGHT TEXT
   ========================================================= */

  function highlightEditor(editorId) {
    const editor = getEditor(editorId);

    if (!editor) {
      return;
    }

    editor.focus();

    restoreSelection(editorId);

    document.execCommand("backColor", false, "#fff3cd");

    saveSelection(editorId);

    editor.focus();
  }

  /* =========================================================
   SELECTION CHANGE
   ========================================================= */

  document.addEventListener("selectionchange", function () {
    const selection = window.getSelection();

    if (!selection || selection.rangeCount === 0) {
      return;
    }

    const range = selection.getRangeAt(0);

    let node = range.commonAncestorContainer;

    if (node.nodeType === Node.TEXT_NODE) {
      node = node.parentNode;
    }

    /*
           Har rich-text editor check karein.
        */

    document.querySelectorAll(".rich-text-editor").forEach(function (editor) {
      if (node && editor.contains(node)) {
        let editorId = "";

        /*
                           Reject editor
                        */

        if (editor.id.startsWith("solveEditorreject")) {
          editorId = editor.id.replace("solveEditorreject", "");
        } else {
          /*
                               Solve editor
                            */

          editorId = editor.id.replace("solveEditor", "");
        }

        if (editorId) {
          editorSelections[editorId] = range.cloneRange();
        }
      }
    });
  });

  /* =========================================================
   PREPARE SOLUTION BEFORE SUBMIT
   ========================================================= */

  function prepareEditor(complaintId) {
    const editor = document.getElementById("solveEditor" + complaintId);

    const hiddenField = document.getElementById("solveHidden" + complaintId);

    if (!editor || !hiddenField) {
      alert("Solution feedback editor could not be found.");
      return false;
    }

    const feedbackText = editor.innerText.trim();

    if (!feedbackText) {
      alert("Please enter solution / feedback.");
      editor.focus();
      return false;
    }

    // Save plain text instead of HTML
    hiddenField.value = feedbackText;

    return true;
  }

  /* =========================================================
   PREPARE REJECTION BEFORE SUBMIT
   ========================================================= */

  function prepareRejectEditor(complaintId) {
    const editor = document.getElementById("solveEditorreject" + complaintId);

    const hiddenField = document.getElementById("rejectHidden" + complaintId);

    if (!editor || !hiddenField) {
      alert("Rejection feedback editor could not be found.");
      return false;
    }

    const feedbackText = editor.innerText.trim();

    if (!feedbackText) {
      alert("Please enter rejection reason / feedback.");
      editor.focus();
      return false;
    }

    // Save plain text instead of HTML
    hiddenField.value = feedbackText;

    return true;
  }


  


function prepareGroupEditor(groupId) {
