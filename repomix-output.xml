                                <span class="badge text-bg-danger">
                                  <i class="bi bi-exclamation-triangle me-1"></i>
                                  Emergency
                                </span>
                              {% else %}
                                <span class="badge text-bg-secondary">
                                  {{ complaint.urgency_level }}
                                </span>
                              {% endif %}
                            </td>

                            <!-- STATUS -->
                            <td>
                              {% if complaint.status == "Pending" %}
                                <span class="badge text-bg-warning">Pending</span>
                              {% elif complaint.status == "Forwarded" %}
                                <span class="badge text-bg-info">Forwarded</span>
                              {% elif complaint.status == "Solved" %}
                                <span class="badge text-bg-success">Solved</span>
                              {% elif complaint.status == "Rejected" %}
                                <span class="badge text-bg-danger">Rejected</span>
                              {% elif complaint.status == "In Progress" %}
                                <span class="badge text-bg-primary">In Progress</span>
                              {% else %}
                                <span class="badge text-bg-secondary">
                                  {{ complaint.status }}
                                </span>
                              {% endif %}
                            </td>

                          </tr>
                        </tbody>

                      </table>
                    </div>

                  </div>
                </div>

              </div>

              <!-- BOTTOM: FULL COMPLAINT DESCRIPTION -->
              <div class="col-12">

                <div class="card border">

                  <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0">
                      <i class="bi bi-chat-left-text me-2"></i>
                      Complaint Description
                    </h6>
                  </div>

                  <div class="card-body">

                    <p class="text-break mb-0"
                      style="white-space: pre-wrap;">{{ complaint.description or 'No description provided.' }}</p>

                  </div>

                </div>

              </div>

            </div>


              <!-- =========================================
                  ADMIN FEEDBACK / REASON
                  ORIGINAL SECTION — UNCHANGED
                  ========================================= -->

              {% if complaint.status == "Solved" or complaint.status == "Rejected" %}

              <div class="mt-4">

                {% if complaint.status == "Solved" %}

                <h6 class="fw-bold mb-2">

                  <i class="bi bi-check-circle text-success me-2"></i>

                  Admin Solution / Feedback

                </h6>

                {% elif complaint.status == "Rejected" %}

                <h6 class="fw-bold mb-2">

                  <i class="bi bi-x-circle text-danger me-2"></i>

                  Admin Rejection Reason / Feedback

                </h6>

                {% endif %}


                <div class="card border">

                  <div class="card-body bg-light">

                    {% if complaint_feedback.get(complaint.id) %}

                      {{ complaint_feedback.get(complaint.id) }}

                    {% else %}

                      <span class="text-muted">
                        No feedback available.
                      </span>

                    {% endif %}

                  </div>

                </div>

              </div>

              {% endif %}

              <hr class="my-4 border-3 opacity-50" />

            </div>
            <!-- END card-body -->

          </div>
          <!-- END card -->

        </div>
        <!-- END modal-body -->



        <!-- ===================================================== -->
        <!-- MODAL FOOTER -->
        <!-- ===================================================== -->

        <div class="modal-footer">

          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal"
          >

            <i class="bi bi-x-lg me-1"></i>

            Close

          </button>

        </div>
        <!-- END modal-footer -->


      </div>
      <!-- END modal-content -->

    </div>
    <!-- END modal-dialog -->

  </div>
  <!-- END modal -->


  {% endfor %}
  <!-- =========================================================
       SOLVE / REJECT MODALS WILL COME IN PART 3
       ========================================================= -->
  <!-- =========================================================
       SOLVE / REJECT MODALS
