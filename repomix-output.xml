<file path="templates/admin_dashboard.html">
{% extends "base.html" %} {% block title %} Admin Dashboard | Smart University
Complaint System {% endblock %} {% block extra_css %}

<!-- =========================================================
     Solution / Feedback Editor
     ========================================================= -->

<style>
  .rich-text-editor {
    min-height: 220px;
    max-height: 350px;

    padding: 18px 20px;

    background-color: #ffffff;

    border: none;
    outline: none;

    font-size: 16px;
    line-height: 1.6;

    cursor: text;

    overflow-y: auto;

    white-space: normal;
  }

  /* Placeholder */

  .rich-text-editor:empty::before {
    content: attr(data-placeholder);

    color: #6c757d;

    pointer-events: none;
  }

  /* Editor focus */

  .rich-text-editor:focus {
    outline: none;
    box-shadow: none;
  }

  /* Selected text */

  .rich-text-editor ::selection {
    background-color: #b6d7ff;
  }

  /* Text inside editor */

  .rich-text-editor p {
    margin-bottom: 8px;
  }

  /* Highlighted text */

  .rich-text-editor span {
    line-height: inherit;
  }
</style>

{% endblock %} {% block content %}

<div class="container py-4 d-flex flex-column">
  <!-- =========================================================
       PAGE HEADER
       ========================================================= -->

  <div
    class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4"
  >
    <div>
      <h2 class="fw-bold mb-1">Admin Dashboard</h2>

      <p class="text-muted mb-0">
        Welcome back, {{ username }}. Manage and monitor student complaints.
      </p>
    </div>

    <div class="mt-3 mt-md-0">
      <span class="badge text-bg-primary px-3 py-2">
        <i class="bi bi-shield-check me-1"></i>

        Administrator
      </span>
    </div>
  </div>

  <!-- =========================================================
       STATISTICS CARDS
       ========================================================= -->

  <div class="row g-4 mb-4">
    <!-- =====================================================
         TOTAL COMPLAINTS
         ===================================================== -->

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Total Complaints</p>

              <h2 class="fw-bold mb-0">{{ complaints|length }}</h2>
            </div>

            <div class="stat-icon bg-primary-subtle text-primary">
              <i class="bi bi-file-earmark-text"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- =====================================================
         EMERGENCY
         ===================================================== -->

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Emergency</p>

              <h2 class="fw-bold mb-0">
                {{ complaints | selectattr("urgency_level", "equalto",
                "Emergency") | selectattr("status", "equalto", "Pending") | list
                | length }}
              </h2>
            </div>

            <div class="stat-icon bg-danger-subtle text-danger">
              <i class="bi bi-exclamation-triangle"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- =====================================================
         PENDING
         ===================================================== -->

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Pending</p>

              <h2 class="fw-bold mb-0">
                {{ complaints | selectattr("status", "equalto", "Pending") |
                list | length }}
              </h2>
            </div>

            <div class="stat-icon bg-warning-subtle text-warning">
              <i class="bi bi-clock-history"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- =====================================================
         SOLVED
         ===================================================== -->

    <div class="col-lg-3 col-md-6">
      <div class="card dashboard-card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted mb-1">Solved</p>

              <h2 class="fw-bold mb-0">
                {{ complaints | selectattr("status", "equalto", "Solved") | list
                | length }}
              </h2>
            </div>

            <div class="stat-icon bg-success-subtle text-success">
              <i class="bi bi-check-circle"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================
       PART 1 COMPLETE
       Complaint Queue starts in Part 2
       ========================================================= -->
  <!-- =========================================================
       COMPLAINT QUEUE
       ========================================================= -->
  <div class="card border-0 shadow-sm mb-4"
      style="order: {{ 2 if groups else 1 }};"
  >
    <!-- =====================================================
         QUEUE HEADER
         ===================================================== -->

    <div class="card-header bg-white border-bottom py-3">
      <div
        class="d-flex flex-column flex-md-row justify-content-between align-items-md-center"
      >
        <div>
          <h5 class="fw-bold mb-1">
            <i class="bi bi-inbox me-2"></i>

            Complaint Queue
          </h5>

          <p class="text-muted small mb-0">
            Manage all student complaints and take appropriate action.
          </p>
        </div>

        <span class="badge text-bg-secondary mt-2 mt-md-0">
          {{ complaints|length }} Complaints
        </span>
      </div>
    </div>

    <!-- =====================================================
             GROUP SELECTED COMPLAINTS
             ===================================================== -->
      <form method="POST">
        <div class="border-top p-3 bg-light"
             id="groupSelectedSection"
             style="display: none;"
        >
          <div
            class="d-flex flex-column flex-md-row justify-content-between align-items-md-center"
          >
            <small class="text-muted mb-2 mb-md-0">
              Select at least 2 pending complaints with the same

              <strong> Directed Against </strong>

              value to create a group.
            </small>

            <button
              type="submit"
              formaction="{{ url_for('group_complaints') }}"
              class="btn btn-primary"
              id="groupSelectedBtn"
              
            >
              <i class="bi bi-collection me-1"></i>

              Group Selected Complaints
            </button>
          </div>
        </div>

    <!-- =====================================================
         COMPLAINT TABLE
         ===================================================== -->

    <div class="card-body p-0">
      {% if complaints %}

      <!-- ===================================================
           MAIN GROUP FORM
           =================================================== -->

      
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <!-- =================================================
                 TABLE HEADER
                 ================================================= -->

            <thead class="table-light">
              <tr>
                <th class="ps-4">Select</th>

                <th>ID</th>

                <th>Student</th>

                <th>Category</th>

                <th>Directed Against</th>

                <th>Description</th>

                <th>Urgency</th>

                <th>Status</th>

                <th>Date</th>

                <th class="text-end pe-4">Actions</th>
              </tr>
            </thead>

            <!-- =================================================
                 TABLE BODY
                 ================================================= -->

            <tbody>
              {% for complaint in complaints %}

              <!-- ===============================================
                   COMPLAINT ROW
                   =============================================== -->

              <tr
                {% if complaint.urgency_level == "Emergency" and complaint.status == "Pending" %}
                class="table-danger"
                {% endif %}
              >
                <!-- =============================================
                     SELECT
                     ============================================= -->

                <td class="ps-4">
                  {% if complaint.status == "Pending" %}

                  <input
                    class="form-check-input complaint-checkbox"
                    type="checkbox"
                    name="complaint_ids"
                    value="{{ complaint.id }}"
                    onclick="
                              const selectedCount = document.querySelectorAll(
                                'input[name=complaint_ids]:checked'
                              ).length;

                              document.getElementById('groupSelectedSection').style.display =
                                selectedCount > 0 ? 'block' : 'none';
                            "
                  />

                  {% endif %}
                </td>

                <!-- =============================================
                     COMPLAINT ID
                     ============================================= -->

                <td>
                  <strong> #{{ complaint.id }} </strong>
                </td>

                <!-- =============================================
                     STUDENT
                     ============================================= -->

                <td>Student {{ complaint.student_id }}</td>

                <!-- =============================================
                     CATEGORY
                     ============================================= -->

                <td>
                  <span class="fw-semibold"> {{ complaint.category }} </span>
                </td>

                <!-- =============================================
                     DIRECTED AGAINST
                     ============================================= -->

                <td>
                  <span class="badge text-bg-dark">
                    {{ complaint.directed_against }}
                  </span>
                </td>

                <!-- ============================= -->
                <!-- DESCRIPTION -->
                <!-- ============================= -->

                <td style="max-width: 250px">
                  <button
                    type="button"
                    class="btn btn-link p-0 text-start text-decoration-none"
                    data-bs-toggle="modal"
                    data-bs-target="#viewComplaintModal{{ complaint.id }}"
                  >
                    {% if complaint.description|length > 60 %} {{
                    complaint.description[:60] }}... {% else %} {{
                    complaint.description }} {% endif %}
                  </button>
                </td>

                <!-- =============================================
                     URGENCY
                     ============================================= -->

                <td>
                  {% if complaint.urgency_level == "Emergency" %}

                  <span class="badge text-bg-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>

                    Emergency
                  </span>

                  {% else %}

                  <span class="badge text-bg-secondary">
                    {{ complaint.urgency_level }}
                  </span>

                  {% endif %}
                </td>

                <!-- =============================================
                     STATUS
                     ============================================= -->

                <td>
                  {% if complaint.status == "Pending" %}

                  <span class="badge text-bg-warning">
                    <i class="bi bi-clock"></i>

                    Pending
                  </span>

                  {% elif complaint.status == "Forwarded" %}

                  <span class="badge text-bg-info">
                    <i class="bi bi-send"></i>

                    Forwarded
                  </span>

                  {% elif complaint.status == "Solved" %}

                  <span class="badge text-bg-success">
                    <i class="bi bi-check-circle"></i>

                    Solved
                  </span>

                  {% elif complaint.status == "Rejected" %}

                  <span class="badge text-bg-danger">
                    <i class="bi bi-x-circle"></i>

                    Rejected
                  </span>

                  {% else %}

                  <span class="badge text-bg-secondary">
                    {{ complaint.status }}
                  </span>

                  {% endif %}
                </td>

                <!-- =============================================
                     DATE
                     ============================================= -->

                <td class="text-muted small">
                  {{ complaint.date_submitted.strftime('%d %b %Y') }}

                  <br />

                  {{ complaint.date_submitted.strftime('%I:%M %p') }}
                </td>

                <!-- =============================================
                     ACTIONS
                     ============================================= -->

                <td class="text-end pe-4">
                  {% if complaint.status == "Pending" %}

                  <div class="btn-group">
                    <!-- =======================================
                           SOLVE BUTTON
                           ======================================= -->

                    <button
                      type="button"
                      class="btn btn-sm btn-success"
                      data-bs-toggle="modal"
                      data-bs-target="#solveModal{{ complaint.id }}"
                    >
                      <i class="bi bi-check-lg"></i>

                      Solve
                    </button>

                    <!-- =======================================
                           FORWARD BUTTON
                           ======================================= -->

                    <button
                      type="submit"
                      formaction="{{ url_for('forward_to_hod', complaint_id=complaint.id) }}"
                      class="btn btn-sm btn-outline-primary"
                      onclick="
                        return confirm(
                          'Are you sure you want to forward this complaint to HOD?',
                        );
                      "
                    >
                      <i class="bi bi-send"></i>

                      Forward
                    </button>

                    <!-- =======================================
                           REJECT BUTTON
                           ======================================= -->

                    <button
                      type="button"
                      class="btn btn-sm btn-outline-danger"
                      data-bs-toggle="modal"
                      data-bs-target="#rejectModal{{ complaint.id }}"
                    >
                      <i class="bi bi-x-lg"></i>

                      Reject
                    </button>
                  </div>

                  {% else %}

                  <span class="text-muted small"> No action required </span>

                  {% endif %}
                </td>
              </tr>

              {% endfor %}
            </tbody>
          </table>
        </div>

        
      </form>

      <!-- =========================================================
           END OF MAIN GROUP FORM
           ========================================================= -->

      {% else %}

      <!-- =====================================================
           EMPTY COMPLAINT QUEUE
           ===================================================== -->

      <div class="text-center py-5">
        <div class="fs-1">📭</div>

        <h5 class="mt-3">No Complaints Available</h5>

        <p class="text-muted mb-0">
          There are currently no complaints in the queue.
        </p>
      </div>

      {% endif %}
    </div>
  </div>


  <!-- ========================================================= -->
  <!-- VIEW COMPLAINT MODALS -->
  <!-- ========================================================= -->

  {% for complaint in all_complaints %}

  <div
    class="modal fade"
    id="viewComplaintModal{{ complaint.id }}"
    tabindex="-1"
    aria-labelledby="viewComplaintModalLabel{{ complaint.id }}"
    aria-hidden="true"
  >
    <!-- ======================================================= -->
    <!-- LARGER POPUP -->
    <!-- ======================================================= -->

    <div
      class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"
    >
      <div class="modal-content">

        <!-- ===================================================== -->
        <!-- MODAL HEADER -->
        <!-- ===================================================== -->

        <div class="modal-header">

          <h4
            class="modal-title fw-bold"
            id="viewComplaintModalLabel{{ complaint.id }}"
          >
            <i class="bi bi-file-earmark-text me-2"></i>
            Complaint Details #{{ complaint.id }}
          </h4>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>

        </div>


        
        <!-- ===================================================== -->
        <!-- MODAL BODY -->
        <!-- ===================================================== -->

        <div class="modal-body bg-light">

          <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

              
              
            <!-- ===================================================== -->
            <!-- COMPLAINT DETAILS + DESCRIPTION: VERTICAL LAYOUT -->
            <!-- ===================================================== -->

            <div class="row g-3">

              <!-- TOP: COMPLAINT DETAILS -->
              <div class="col-12">

                <div class="card border">

                  <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0">
                      <i class="bi bi-card-list me-2"></i>
                      Complaint Details
                    </h6>
                  </div>

                  <div class="card-body p-0">

                    <div class="table-responsive">
                      <table class="table table-bordered align-middle mb-0">

                        <thead class="table-light">
                          <tr>
                            <th>ID</th>
                            <th>Student</th>
                            <th>Category</th>
                            <th>Directed Against</th>
                            <th>Urgency</th>
                            <th>Status</th>
                          </tr>
                        </thead>

                        <tbody>
                          <tr>

                            <!-- ID -->
                            <td>
                              <strong>#{{ complaint.id }}</strong>
                            </td>

                            <!-- STUDENT -->
                            <td>
                              Student {{ complaint.student_id }}
                            </td>

                            <!-- CATEGORY -->
                            <td>
                              <span class="fw-semibold">
                                {{ complaint.category }}
                              </span>
                            </td>

                            <!-- DIRECTED AGAINST -->
                            <td>
                              <span class="badge text-bg-dark">
                                {{ complaint.directed_against }}
                              </span>

                              {% if complaint.custom_target %}
                                <div class="text-muted small mt-1">
                                  {{ complaint.custom_target }}
                                </div>
                              {% endif %}
                            </td>

                            <!-- URGENCY -->
                            <td>
