<file path="templates/submit_complaint.html">
{% extends "base.html" %}

{% block title %}
Submit Complaint | Smart University Complaint System
{% endblock %}


{% block content %}

<div class="container py-5">

    <!-- Page Heading -->
    <div class="row mb-4">

        <div class="col-md-8">

            <h2 class="fw-bold">
                Submit a Complaint
            </h2>

            <p class="text-muted">
                Submit your issue and track its status from your dashboard.
            </p>

        </div>

        <div class="col-md-4 text-md-end">

            <a
                href="{{ url_for('student_dashboard') }}"
                class="btn btn-outline-primary"
            >
                ← Back to Dashboard
            </a>

        </div>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <!-- Card Header -->
                <div class="card-header bg-primary text-white py-3">

                    <h5 class="mb-0">
                        Complaint Information
                    </h5>

                </div>


                <!-- Card Body -->
                <div class="card-body p-4">

                    <form
                        method="POST"
                        id="complaintForm"
                    >

                        <!-- ================================= -->
                        <!-- CATEGORY -->
                        <!-- ================================= -->

                        <div class="mb-3">

                            <label
