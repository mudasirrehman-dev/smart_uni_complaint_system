            <th class="ps-3 py-3">Complaint ID</th>
            <th class="px-3 py-3">Category</th>
            <th class="px-3 py-3">Directed Against</th>
            <th class="px-3 py-3">Description</th>
            <th class="px-3 py-3">Urgency</th>
            <th class="px-3 py-3">Status</th>
          </tr>
        </thead>

        <tbody>
          {% for complaint in complaints_in_group %}
          <tr>
            <td class="ps-3 py-3"><strong>#{{ complaint.id }}</strong></td>

            <td class="px-3 py-3">{{ complaint.category }}</td>

            <td class="px-3 py-3">{{ complaint.directed_against }}</td>

            <td class="px-3 py-3" style="max-width: 200px;">
              <button
                type="button"
                class="btn btn-link p-0 text-start text-decoration-none"
                data-bs-toggle="modal"
                data-bs-target="#viewComplaintModal{{ complaint.id }}"
              >
                {% if complaint.description|length > 60 %}
                  {{ complaint.description[:60] }}...
                {% else %}
                  {{ complaint.description }}
                {% endif %}
              </button>
            </td>

            <td class="px-3 py-3">
              {% if complaint.urgency_level == "Emergency" %}
                <span class="badge text-bg-danger">Emergency</span>
              {% else %}
                <span class="badge text-bg-secondary">{{ complaint.urgency_level }}</span>
              {% endif %}
            </td>

            <td class="px-3 py-3">
              {% if complaint.status == "Pending" %}
                <span class="badge text-bg-warning">Pending</span>
              {% elif complaint.status == "Forwarded" %}
                <span class="badge text-bg-info">Forwarded</span>
              {% elif complaint.status == "Solved" %}
                <span class="badge text-bg-success">Solved</span>
              {% elif complaint.status == "Rejected" %}
                <span class="badge text-bg-danger">Rejected</span>
              {% else %}
                <span class="badge text-bg-secondary">{{ complaint.status }}</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>

      </table>
    </div>

  </div>
  <!-- END GROUP CARD -->

  {% endfor %}
</div>
<!-- END card-body -->

</div>
<!-- END GROUPED COMPLAINTS CARD -->


