                >
                    Submit Your First Complaint
                </a>

                {% endif %}

            </div>

            {% endif %}

        </div>

    </div>


    <!-- ============================= -->
    <!-- MONTHLY QUOTA - RIGHT SIDE -->
    <!-- ============================= -->

    <div class="col-lg-4">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">


                <!-- Header -->

                <div
                    class="d-flex justify-content-between align-items-center mb-4"
                >

                    <div>

                        <h5 class="fw-bold mb-1">
