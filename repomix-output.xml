<file path="templates/student_dashboard.html">
{% extends "base.html" %}

{% block title %}
Student Dashboard | Smart University Complaint System
{% endblock %}


{% block content %}

<!-- ============================= -->
<!-- WELCOME SECTION -->
<!-- ============================= -->

<div class="mb-4">

    <h2 class="fw-bold">
        Welcome back, {{ username }} 👋
    </h2>

    <p class="text-muted mb-0">
        Manage and track your submitted complaints.
    </p>

</div>


<!-- ============================= -->
<!-- STATISTICS CARDS -->
<!-- ============================= -->

<div class="row g-4 mb-4">

    <!-- Total Complaints -->
    <div class="col-lg-3 col-md-6">

        <div class="card dashboard-card h-100 border-0 shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <p class="text-muted mb-1">
                            Total Complaints
                        </p>

                        <h2 class="fw-bold mb-0">
                            {{ complaints|length }}
                        </h2>

                    </div>

                    <div class="stat-icon bg-primary-subtle text-primary">

                        <i class="bi bi-file-earmark-text"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Pending Complaints -->
    <div class="col-lg-3 col-md-6">

        <div class="card dashboard-card h-100 border-0 shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <p class="text-muted mb-1">
                            Pending
                        </p>

                        <h2 class="fw-bold mb-0">

                            {{
                                complaints
                                | selectattr("status", "equalto", "Pending")
                                | list
                                | length
                            }}

                        </h2>

                    </div>

                    <div class="stat-icon bg-warning-subtle text-warning">

                        <i class="bi bi-clock-history"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Forwarded Complaints -->
    <div class="col-lg-3 col-md-6">

        <div class="card dashboard-card h-100 border-0 shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <p class="text-muted mb-1">
                            Forwarded
                        </p>

                        <h2 class="fw-bold mb-0">

                            {{
                                complaints
                                | selectattr("status", "equalto", "Forwarded")
                                | list
                                | length
                            }}

                        </h2>

                    </div>

                    <div class="stat-icon bg-info-subtle text-info">

                        <i class="bi bi-send"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Solved Complaints -->
    <div class="col-lg-3 col-md-6">

        <div class="card dashboard-card h-100 border-0 shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <p class="text-muted mb-1">
                            Solved
                        </p>

                        <h2 class="fw-bold mb-0">

                            {{
                                complaints
                                | selectattr("status", "equalto", "Solved")
                                | list
                                | length
                            }}

                        </h2>

                    </div>

                    <div class="stat-icon bg-success-subtle text-success">

                        <i class="bi bi-check-circle"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ============================= -->
<!-- MAIN DASHBOARD SECTION -->
<!-- LEFT: MY COMPLAINTS -->
<!-- RIGHT: MONTHLY QUOTA -->
<!-- ============================= -->

<div class="row g-4">


    <!-- ============================= -->
    <!-- MY COMPLAINTS - LEFT SIDE -->
    <!-- ============================= -->

    <div class="card shadow-sm border-0 h-100">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h4 class="fw-bold mb-1">
                        My Complaints
                    </h4>

                    <p class="text-muted mb-0">
                        Track the status of your submitted complaints.
                    </p>
                </div>

                {% if complaints_remaining > 0 %}
                <a
                    href="{{ url_for('submit_complaint') }}"
                    class="btn btn-primary"
                >
                    + Submit Complaint
                </a>
                {% endif %}

            </div>


            {% if complaints %}

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>ID</th>
                            <th>Category</th>
                            <th>Directed Against</th>
                            <th>Description</th>
                            <th>Urgency</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>

                    </thead>


                    <tbody>

                        {% for complaint in complaints %}

                        <tr>

                            <td>
                                <span class="fw-bold">
                                    #{{ complaint.id }}
                                </span>
                            </td>


                            <td>
                                <span class="fw-semibold">
                                    {{ complaint.category }}
                                </span>
                            </td>


                            <td>
                                {{ complaint.directed_against }}
                            </td>


                          
                            
                            <!-- ============================= -->
                            <!-- DESCRIPTION -->
                            <!-- ============================= -->

                            <td style="max-width: 250px">
                            <button
                                type="button"
                                class="btn btn-link p-0 text-start text-decoration-none"
                                data-bs-toggle="modal"
                                data-bs-target="#viewComplaintModal{{ complaint.id }}"
                            >
                                {% if complaint.description|length > 60 %} {{
                                complaint.description[:60] }}... {% else %} {{
                                complaint.description }} {% endif %}
                            </button>
                            </td>


                            <!-- Urgency -->
                            <td>

                                {% if complaint.urgency_level == "Emergency" %}

                                <span class="badge text-bg-danger">
                                    🚨 Emergency
                                </span>

                                {% else %}

                                <span class="badge text-bg-secondary">
                                    {{ complaint.urgency_level }}
                                </span>

                                {% endif %}

                            </td>


                            <!-- Status -->
                            <td>

                                {% if complaint.status == "Pending" %}

                                <span class="badge text-bg-warning">
                                    Pending
                                </span>

                                {% elif complaint.status == "Forwarded" %}

                                <span class="badge text-bg-info">
                                    Forwarded
                                </span>

                                {% elif complaint.status == "Solved" %}

                                <span class="badge text-bg-success">
                                    Solved
                                </span>

                                {% elif complaint.status == "Rejected" %}

                                <span class="badge text-bg-danger">
                                    Rejected
                                </span>

                                {% else %}

                                <span class="badge text-bg-secondary">
                                    {{ complaint.status }}
                                </span>

                                {% endif %}

                            </td>


                            <!-- Date -->
                            <td class="text-muted small">

                                {{ complaint.date_submitted.strftime('%d %b %Y') }}

                                <br>

                                {{ complaint.date_submitted.strftime('%I:%M %p') }}

                            </td>
                            <!-- Action -->

                            <td>

                                <a
                                    href="{{ url_for('complaint_details', complaint_id=complaint.id) }}"
                                    class="btn btn-sm btn-outline-primary"
                                >
                                    <i class="bi bi-eye"></i>
                                    View Details
                                </a>

                            </td>

                        </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>


            {% else %}

            <!-- Empty State -->

            <div class="text-center py-5">

                <div class="fs-1">
                    📭
                </div>

                <h5 class="mt-3">
                    No Complaints Yet
                </h5>

                <p class="text-muted">
                    You have not submitted any complaints yet.
                </p>

                {% if complaints_remaining > 0 %}

                <a
                    href="{{ url_for('submit_complaint') }}"
                    class="btn btn-primary"
                >
                    Submit Your First Complaint
                </a>

                {% endif %}

            </div>

            {% endif %}

        </div>

    </div>


    <!-- ============================= -->
    <!-- MONTHLY QUOTA - RIGHT SIDE -->
    <!-- ============================= -->

    <div class="col-lg-4">

        <div class="card border-0 shadow-sm h-100">

            <div class="card-body p-4">


                <!-- Header -->

                <div
                    class="d-flex justify-content-between align-items-center mb-4"
                >

                    <div>

                        <h5 class="fw-bold mb-1">
                            Monthly Complaint Quota
                        </h5>

                        <p class="text-muted small mb-0">
                            Your complaint limit for this month.
                        </p>

                    </div>


                    <div class="stat-icon bg-primary-subtle text-primary">

                        <i class="bi bi-speedometer2"></i>

                    </div>

                </div>


                <!-- Used Complaints -->

                <div class="text-center mb-4">

                    <h1 class="fw-bold mb-1">

                        {{ complaints_used }}

                        <span class="text-muted fs-4">
                            /5
                        </span>

                    </h1>

                    <p class="text-muted mb-0">
                        Complaints Used
                    </p>

                </div>


                <!-- Progress Bar -->

                <div
                    class="progress mb-3"
                    style="height: 10px;"
                >

                    <div
                        class="progress-bar"
                        role="progressbar"
                        style="width: {{ complaints_used * 20 }}%;"
                        aria-valuenow="{{ complaints_used }}"
                        aria-valuemin="0"
                        aria-valuemax="5"
                    ></div>

                </div>


                <!-- Remaining -->

                <div
                    class="d-flex justify-content-between align-items-center mb-4"
                >

                    <span class="text-muted">

                        Remaining Complaints

                    </span>


                    <span class="fw-bold">

                        {{ complaints_remaining }}

                    </span>

                </div>


                <hr>


                <!-- Submit Complaint Button -->

                {% if complaints_remaining > 0 %}

                <a
                    href="{{ url_for('submit_complaint') }}"
                    class="btn btn-primary w-100 py-2"
                >

                    <i class="bi bi-plus-circle me-1"></i>

                    Submit Complaint

                </a>


                {% else %}

                <button
                    class="btn btn-secondary w-100 py-2"
                    disabled
                >

                    <i class="bi bi-lock me-1"></i>

                    Monthly Limit Reached

                </button>

                {% endif %}


            </div>

        </div>

    </div>


</div>
<!-- ========================================================= -->
<!-- STUDENT VIEW COMPLAINT MODALS -->
<!-- ========================================================= -->

{% for complaint in complaints %}

<div
    class="modal fade"
